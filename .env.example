# Server (Node / Express) - local dev
PORT=3000
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SERVICE_ACCOUNT_JSON=

# Client (Vite) - Public OAuth client ID (Web application)
# Injected at BUILD time (Vite). Set it in the deploy environment / CI.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudflare (Workers + Static Assets, see wrangler.jsonc)
# GEMINI_API_KEY is used by the Worker (worker/index.ts) and must be a SECRET:
#   npx wrangler secret put GEMINI_API_KEY
#   (or Dashboard > Workers & Pages > gmail-pro > Settings > Variables and Secrets)
# Local Worker dev: put secrets in .dev.vars (gitignored) and run `npm run worker:dev`.
#
# Optional: Node version for the build environment.
# Wrangler >= 4.142 REQUIRES Node >= 22 — keep this at 22.
NODE_VERSION=22
NODE_ENV=production
