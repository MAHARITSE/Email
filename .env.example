# Server (Node / Express) - local dev
PORT=3000
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_SERVICE_ACCOUNT_JSON=

# Client (Vite) - Public OAuth client ID (Web application)
# Used at build time, must be set in Cloudflare Pages dashboard as VITE_GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Cloudflare Pages Functions - same as server
# Set GEMINI_API_KEY as secret in Cloudflare dashboard:
# wrangler pages secret put GEMINI_API_KEY  OR  Dashboard > Settings > Environment Variables
# Set VITE_GOOGLE_CLIENT_ID as var in dashboard (public)

# Optional: Node version for Cloudflare Pages build
NODE_VERSION=20
NODE_ENV=production
