{
  // Wrangler configuration — Cloudflare **Workers + Static Assets**.
  // Deploy with:  npx wrangler deploy
  //
  // - main   : Worker entry point, handles /api/* (see worker/index.ts)
  // - assets : the built SPA in ./dist, served by Cloudflare's asset layer,
  //            with index.html as fallback for client-side routes (SPA)
  //
  // NOTE: do NOT add "pages_build_output_dir" here — wrangler would then treat
  // this project as Cloudflare Pages and abort `wrangler deploy`. The Pages
  // alternative is documented in README.md (`functions/` + `wrangler pages deploy`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmail-pro",
  "main": "worker/index.ts",
  // Runtime compatibility date (bumped from 2024-12-01 so /api/* routing and the
  // static-assets behaviour match the current Workers runtime).
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Deep links such as /inbox/thread/42 must return index.html (React Router SPA).
    "not_found_handling": "single-page-application",
    // Only /api/* invokes the Worker script; all other requests are served as
    // static assets, so the SPA never pays for a Worker invocation.
    "run_worker_first": ["/api/*"]
  },
  "build": {
    // `wrangler deploy` builds ./dist itself (vite build + server bundle).
    "command": "npm run build"
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
