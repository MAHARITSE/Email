{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmail-pro",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "build": {
    "command": "npm run build:cloudflare"
  },
  "vars": {
    "NODE_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
